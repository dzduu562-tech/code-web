# Optional: URL Rewriting (not required, using index.php?route= works fine)
# Uncomment below if you want cleaner URLs

# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteBase /elearning/public/
#     
#     # Redirect to public/index.php if not a file or directory
#     RewriteCond %{REQUEST_FILENAME} !-f
#     RewriteCond %{REQUEST_FILENAME} !-d
#     RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]
# </IfModule>

# Security: Prevent directory listing
Options -Indexes

# Security: Protect config files
<FilesMatch "^(config\.php|\.env)">
    Order allow,deny
    Deny from all
</FilesMatch>
